{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Name": "dev",
  "EncryptionKey": "",
  "ConnectionStrings": {
    "Database": ""
  },
  "Kubernetes": {
    "Namespace": "churrostack",
    "ServiceMesh": null, // Options: null, "istio",
    "StorageClass": null, // Options: null, emptyDir, hostPath, openebs-hostpath
    "SharedStorageClass": null, // Options: null, emptyDir, hostPath, openebs-hostpath
    "Limits": {
      "Cpu": "",
      "Memory": "",
      "Storage": "",
      "Gpu": null
    },
    // Per-environment resource overcommit factors applied by the control plane when admitting
    // a Start/Deploy. Running apps are charged by their request (what the cluster reserves),
    // not their limit (burst ceiling) — so CPU already packs ~2x even with every factor at the
    // neutral default of 1.0. All factors default to 1.0 (overcommit off) when unset. Keep the
    // quota (Limits) at or below real node allocatable; set Cpu > 1 only on shared slices.
    "Overcommit": {
      "Cpu": null, // e.g. "1.5" to admit 1.5x the CPU request budget (throttle-safe)
      "Memory": null, // memory request-sum factor (keep ~1.0 so requests stay schedulable)
      "MemoryBurst": null // memory limit-sum ceiling; set e.g. "1.5" to allow ~1.5x memory burst
    },
    "Connection": {
      "Host": "",
      "SkipTlsVerify": true,
      "ClientCertificateData": "",
      "ClientCertificateKeyData": ""
    },
    "DebugDestinationHost": ""
  }
}
